{
  "name": "markshot-app",
  "productName": "MarkShot",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "main": "src/main.mjs",
  "description": "A resident macOS app that turns Markdown and rich text into shareable long images.",
  "scripts": {
    "start": "node node_modules/@electron-forge/cli/dist/electron-forge.js start",
    "package:app": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ node node_modules/@electron-forge/cli/dist/electron-forge.js package --arch=arm64",
    "test": "node --test",
    "check": "node --check src/main.mjs && node --check src/diagram-preload.cjs && node --check src/diagrams.mjs && node --check src/documents.mjs && node --check src/i18n.mjs && node --check src/png.mjs && node --check src/rendering.mjs && node --check src/settings.mjs && node --check src/ui/app.js"
  },
  "dependencies": {
    "@viz-js/viz": "3.28.0",
    "echarts": "6.1.0",
    "highlight.js": "11.11.1",
    "json5": "2.2.3",
    "markmap-lib": "0.18.12",
    "markmap-view": "0.18.12",
    "marked": "16.4.2",
    "marked-footnote": "1.4.0",
    "marked-highlight": "2.2.4",
    "mermaid": "11.16.0",
    "sanitize-html": "2.17.5",
    "vega": "6.3.1",
    "vega-interpreter": "2.3.1",
    "vega-lite": "6.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "electron": "39.8.10"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "name": "MarkShot",
        "executableName": "MarkShot",
        "appBundleId": "com.wuzhiruge.markshot",
        "appCategoryType": "public.app-category.productivity",
        "icon": "assets/app-icon.icns",
        "extendInfo": {
          "CFBundleDocumentTypes": [
            {
              "CFBundleTypeName": "Markdown Document",
              "CFBundleTypeRole": "Viewer",
              "LSHandlerRank": "Alternate",
              "CFBundleTypeExtensions": [
                "md",
                "markdown",
                "mdown"
              ]
            }
          ]
        },
        "asar": true,
        "platform": "darwin",
        "arch": "arm64",
        "ignore": [
          "^/tests($|/)",
          "^/macos($|/)",
          "^/scripts($|/)",
          "^/out($|/)",
          "^/node_modules/.*\\.map$",
          "^/node_modules/.*\\.d\\.(?:ts|cts|mts)$",
          "^/node_modules/echarts/dist($|/)",
          "^/node_modules/mermaid/dist/chunks/mermaid\\.esm(?:\\.min)?($|/)",
          "^/node_modules/mermaid/dist/mermaid(?:\\.esm(?:\\.min)?\\.mjs|(?:\\.min)?\\.js)(?:\\.map)?$"
        ]
      }
    }
  }
}
